// Middleware to verify Admin privileges from JWT
const requireAdmin = (req, res, next) => {
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ error: 'Missing token' });
  }

  const token = authHeader.split(' ')[1];
  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    if (decoded.role !== 'admin') {
      return res.status(403).json({ error: 'Admin access required' });
    }
    req.user = decoded;
    next();
  } catch (err) {
    return res.status(403).json({ error: 'Invalid or expired token' });
  }
};

// 1. Admin System Health & Metrics Dashboard
app.get('/api/admin/metrics', requireAdmin, (req, res) => {
  const uptime = process.uptime();
  const memoryUsage = process.memoryUsage();
  
  res.json({
    status: 'healthy',
    serverUptimeSeconds: Math.floor(uptime),
    memoryRSSMB: (memoryUsage.rss / 1024 / 1024).toFixed(2),
    memoryHeapMB: (memoryUsage.heapUsed / 1024 / 1024).toFixed(2),
    nodeVersion: process.version,
    platform: process.platform,
    activeUser: req.user.username
  });
});

// 2. Admin Action: Restart backend service or trigger container maintenance check
app.post('/api/admin/maintenance', requireAdmin, (req, res) => {
  // In a real multi-container setup, this could signal Docker to cycle worker containers
  res.json({ success: true, message: 'Maintenance signal acknowledged by backend gateway.' });
});
